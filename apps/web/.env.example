# Where the storefront server reaches the API (server-to-server, never exposed to the browser).
API_URL=http://localhost:4000
# Local development only: send this host to the API instead of the browser's host,
# so http://localhost:3000 renders a store whose verified domain is e.g. shop.example.com.
# Leave empty in staging/production. The API must trust this server to read X-Forwarded-Host: TRUST_PROXY=loopback
# when both run on one machine, or this server's address in deployment (docs/DEPLOYMENT.md, "TRUST_PROXY by environment").
STORE_HOST_OVERRIDE=
# Local preview only: show a different display name/logo than the store's database record (logo may be a /public path).
# Leave empty in staging/production; real stores set name and logo in the admin.
STOREFRONT_BRAND_NAME=
STOREFRONT_LOGO_URL=
