# Copy to .env for local development. Never commit real secrets.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom
# Set to true only when running behind a trusted reverse proxy that sets X-Forwarded-Host/For
TRUST_PROXY=false

# Keys the HMAC used to store OTP codes. 32+ characters. Required (and must be changed) in production.
OTP_HMAC_SECRET=replace-with-a-random-string-of-at-least-32-chars

CUSTOMER_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Outbound providers. Only non-live adapters exist:
#   SMS_PROVIDER: log (development only; codes are kept in memory, never logged) | disabled
#   PAYMENT_PROVIDER: none | fake (development/test only; moves no money)
#   POS_ADAPTER: none (the real POS API is not yet verified)
SMS_PROVIDER=log
PAYMENT_PROVIDER=none
# Required only when PAYMENT_PROVIDER=fake. 16+ characters.
# FAKE_PAYMENT_WEBHOOK_SECRET=dev-only-fake-webhook-secret
POS_ADAPTER=none

WORKER_POLL_INTERVAL_MS=2000
